# =============================================================================
# Configuración de la Sede Electrónica — plantilla
#
# Copiar a `.env` y rellenar. NINGÚN valor real se escribe aquí: este archivo SÍ
# se versiona y el repositorio es público.
#
# En producción los valores llegan desde los secretos del entorno de despliegue y
# se renderizan en el `.env` del servidor. La plantilla del despliegue vive en
# `deploy/plantilla.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------
APP_NAME="Sede Electrónica · Santa Marta"
# `local` en desarrollo, `production` en los entornos desplegados.
APP_ENV=local
# Obligatoria. Se genera con `php artisan key:generate`.
# SI SE PIERDE, los datos cifrados de la base quedan irrecuperables aunque la
# copia de seguridad esté intacta. Su custodia está descrita en `accesos.md`.
APP_KEY=
# Nunca `true` fuera de desarrollo: la aplicación lo comprueba al arrancar.
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/Bogota

APP_MAINTENANCE_DRIVER=file

# -----------------------------------------------------------------------------
# Registro
#
# El canal `security` es obligatorio: la auditoría de acceso a datos personales
# lo exige y tiene su propia retención.
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single,security
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Base de datos
#
# PostgreSQL 18. Dentro de la pila, el anfitrión es el nombre del servicio.
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sede
DB_USERNAME=sede
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Sesión, caché y colas
#
# Redis, no archivos: hay más de un proceso y una sesión en disco no se comparte.
# -----------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=sede_

# -----------------------------------------------------------------------------
# Autenticación
# -----------------------------------------------------------------------------
# Dominios que pueden usar la sesión con cookie. Nunca `*`.
SANCTUM_STATEFUL_DOMAINS=staging.santamarta.gov.co
SANCTUM_GUARD=web

# -----------------------------------------------------------------------------
# Almacenamiento de objetos
#
# El contrato con el almacenamiento es S3, no un producto concreto: cambiar de
# proveedor es cambiar estas líneas, nunca el dominio de la aplicación.
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=nyc3
AWS_BUCKET=sede-documentos
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Proxy de confianza
#
# Los rangos de Cloudflare, **nunca `*`**. La aplicación debe creer el esquema y
# la dirección que declara el punto de entrada, y sólo a él.
# -----------------------------------------------------------------------------
TRUSTED_PROXIES=

# -----------------------------------------------------------------------------
# Correo
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@santamarta.gov.co"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Copias de seguridad
#
# La frase de paso cifra el volcado. **Su pérdida hace inservibles las copias.**
# -----------------------------------------------------------------------------
BACKUP_DISK=s3
BACKUP_PASSPHRASE=

# -----------------------------------------------------------------------------
# Sede
#
# Lo que la aplicación necesita saber de sí misma y de sus integraciones. El
# detalle de cada integración vive en `config/sede.php`.
# -----------------------------------------------------------------------------
SEDE_DOMINIO=staging.santamarta.gov.co
SEDE_URL=https://staging.santamarta.gov.co
# Orígenes autorizados a llamar a la API. Vacío = sólo el propio dominio.
SEDE_ORIGENES_PERMITIDOS=

# Integraciones. `mock` mientras no haya credenciales; `live` en producción.
# Una integración sin credenciales se declara apagada, en lugar de ofrecer un
# botón que no lleva a ninguna parte.
SEDE_IDENTIDAD_DRIVER=mock
SEDE_IDENTIDAD_EMISOR=
SEDE_IDENTIDAD_CLIENTE_ID=
SEDE_IDENTIDAD_CLIENTE_SECRETO=

SEDE_PAGOS_DRIVER=mock
SEDE_PAGOS_SECRETO=

SEDE_CORREO_CERTIFICADO_DRIVER=mock
SEDE_CORREO_CERTIFICADO_SECRETO=

SEDE_CAPTCHA_DRIVER=local
SEDE_CAPTCHA_SECRETO=

# -----------------------------------------------------------------------------
# Super-admin sembrado
#
# `SuperAdminSeeder` crea esta cuenta con `updateOrCreate`. Si la clave falta, el
# sembrador usa una de desarrollo y **se niega a correr en producción**: el
# repositorio es público y una credencial literal aquí sería una credencial
# filtrada desde el primer commit.
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=super-admin@santamarta.gov.co
SUPER_ADMIN_NAME="Super Administrador"
SUPER_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# CORS
#
# El origen del cliente que puede llamar a la API con credenciales. El nombre lo
# fija la guía maestra y `config/cors.php` lo lee con este valor por defecto.
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
