# Plantilla del entorno de la sede.
#
# La canalización la renderiza en cada despliegue y deja el resultado en
# /opt/sede/<entorno>/.env, en el servidor.
#
# Los valores que llevan `${...}` los sustituye la canalización desde los
# secretos del entorno de GitHub. **Ningún valor real vive en este archivo**: se
# versiona y el repositorio es público.

# --- Aplicación --------------------------------------------------------------
APP_NAME=sede
APP_ENV=production
APP_DEBUG=false
APP_KEY=${APP_KEY}
APP_URL=https://${DOMINIO}
APP_VERSION=${VERSION}
APP_TIMEZONE=America/Bogota
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# --- Registro ----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single,security
LOG_LEVEL=warning

# --- Base de datos ------------------------------------------------------------
# Dentro de la pila, el anfitrión es el nombre del servicio. No hay puerto
# publicado: sólo se alcanza desde la red interna.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=${DB_DATABASE}
DB_USERNAME=${DB_USERNAME}
DB_PASSWORD=${DB_PASSWORD}

# --- Sesión, caché y colas ---------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=${DOMINIO}

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=sede_

# --- Autenticación -----------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=${DOMINIO}
SANCTUM_GUARD=web

# --- Almacenamiento de objetos ------------------------------------------------
# El contrato es S3, no un producto. Cambiar de proveedor es cambiar estas
# líneas, nunca el dominio de la aplicación.
# El disco se DECLARA desde fuera en lugar de fijarlo aquí. Fijarlo a `s3` cuando
# todavía no hay depósito de objetos hace que la pila arranque y falle al primer
# archivo, con un error que habla del depósito y no de que no existe. Declararlo
# permite usar el disco local como apaño MIENTRAS no haya depósito, y que el
# cambio a `s3` sea entonces una línea, no una investigación.
FILESYSTEM_DISK=${FILESYSTEM_DISK}
AWS_ACCESS_KEY_ID=${S3_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${S3_SECRET_KEY}
AWS_DEFAULT_REGION=${S3_REGION}
AWS_BUCKET=${S3_BUCKET}
AWS_ENDPOINT=${S3_ENDPOINT}
AWS_USE_PATH_STYLE_ENDPOINT=${S3_PATH_STYLE}

# --- Correo ------------------------------------------------------------------
MAIL_MAILER=${MAIL_MAILER}
MAIL_HOST=${MAIL_HOST}
MAIL_PORT=${MAIL_PORT}
MAIL_USERNAME=${MAIL_USERNAME}
MAIL_PASSWORD=${MAIL_PASSWORD}
MAIL_FROM_ADDRESS=no-responder@${DOMINIO}
MAIL_FROM_NAME="Sede Electrónica"

# --- Copias de seguridad ------------------------------------------------------
BACKUP_DISK=s3
BACKUP_PASSPHRASE=${BACKUP_PASSPHRASE}

# --- Sede --------------------------------------------------------------------
SEDE_DOMINIO=${DOMINIO}
SEDE_URL=https://${DOMINIO}
SEDE_ORIGENES_PERMITIDOS=${ORIGENES_PERMITIDOS}

# La dirección de la API para el sitio (ADR-0018).
#
# HISTORIA, porque explica por qué hay dos variables:
#
# 1. Faltaba la variable y la sede quedaba inservible: `nuxt.config.ts` cae a
#    `/api/v1`, una ruta relativa que durante el renderizado en servidor se
#    resolvía contra el propio contenedor del sitio, que no servía `/api` (404).
#    Con los 123 trámites ya sembrados el catálogo salía «no disponible» y cada
#    ficha respondía 404.
# 2. Se arregló apuntando a la URL PÚBLICA (`https://<dominio>/api/v1`). Funcionó,
#    pero la petición salía a Internet, volvía por Cloudflare y la API la veía
#    llegar desde la dirección del servidor del sitio: todos los visitantes
#    compartían un solo cupo de peticiones (medido en staging con dos equipos:
#    uno recibía el error en el mismo segundo en que el otro cruzaba el umbral).
# 3. Ahora el sitio ofrece una ruta propia `/api/v1` (`sitio/server/routes/api/v1`)
#    que reenvía por la red de Docker al puerto interno de nginx, con la dirección
#    del visitante. Por eso la URL pública vuelve a ser RELATIVA —ahora sí hay
#    quien la sirva dentro del contenedor— y la dirección interna es otra variable.
#
# **El nombre importa.** `nuxt.config.ts` lee `SEDE_API_URL` al CONSTRUIR la imagen;
# en tiempo de ejecución Nuxt sólo acepta la variable con su prefijo, `NUXT_` más la
# ruta del ajuste (`public.apiUrl` → `NUXT_PUBLIC_API_URL`, `apiInterna` →
# `NUXT_API_INTERNA`).
#
# `NUXT_API_INTERNA` apunta al puerto 8080 de nginx, que NO se publica
# (`compose.yaml` sólo publica 80 y 443; la guarda «El canal interno del sitio no se
# publica» de CI lo comprueba). Si esta variable faltara, la ruta responde 503 y el
# sitio muestra sus estados de error: se nota, no se falsea nada.
NUXT_PUBLIC_API_URL=/api/v1
NUXT_API_INTERNA=http://nginx:8080

# Integraciones externas. `mock` mientras no haya credenciales: una integración
# sin credenciales se declara apagada en lugar de ofrecer un botón que no lleva a
# ninguna parte.
SEDE_IDENTIDAD_DRIVER=${IDENTIDAD_DRIVER}
SEDE_IDENTIDAD_EMISOR=${IDENTIDAD_EMISOR}
SEDE_IDENTIDAD_CLIENTE_ID=${IDENTIDAD_CLIENTE_ID}
SEDE_IDENTIDAD_CLIENTE_SECRETO=${IDENTIDAD_CLIENTE_SECRETO}

SEDE_PAGOS_DRIVER=${PAGOS_DRIVER}
SEDE_PAGOS_SECRETO=${SEDE_PAGOS_SECRETO}

SEDE_CORREO_CERTIFICADO_DRIVER=${CORREO_CERTIFICADO_DRIVER}
SEDE_CORREO_CERTIFICADO_SECRETO=${SEDE_CORREO_CERTIFICADO_SECRETO}

SEDE_CAPTCHA_DRIVER=${CAPTCHA_DRIVER}
SEDE_CAPTCHA_SECRETO=${CAPTCHA_SECRETO}

# --- Super-admin sembrado -----------------------------------------------------
# La cuenta que `SuperAdminSeeder` crea con `updateOrCreate`. **La clave no está
# en el repositorio**: se lee del registro de secretos, que no se versiona. Antes
# viajaba como valor por defecto en `config/superadmin.php` de un repositorio
# público, es decir, publicada.
#
# Si `SUPER_ADMIN_PASSWORD` llega vacía, el sembrador cae en su clave de
# desarrollo y **se niega a sembrar en producción**: un despliegue sin la
# variable falla en vez de dejar la cuenta de máximo privilegio con una
# contraseña conocida.
SUPER_ADMIN_EMAIL=${SUPER_ADMIN_EMAIL}
SUPER_ADMIN_NAME=${SUPER_ADMIN_NAME}
SUPER_ADMIN_PASSWORD=${SUPER_ADMIN_PASSWORD}

# --- Pila de contenedores -----------------------------------------------------
# El registro de imágenes y la versión las fija la canalización.
# El registro exige el nombre en MINÚSCULAS. Si aquí llega con mayúsculas, la
# publicación falla al etiquetar la imagen y el servidor pide una que no existe,
# sin que ninguna de las dos cosas diga por qué.
REGISTRY=${REGISTRY}
COMPOSE_PROJECT_NAME=sede-${ENTORNO}

# Sólo el punto de entrada publica puertos, y sólo estos dos.
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Dónde vive el certificado del origen, montado en sólo lectura.
SEDE_CERTS_DIR=/opt/sede/${ENTORNO}/certs

HORIZON_REPLICAS=1
