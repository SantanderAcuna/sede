# Valores NO secretos del entorno de producción (ADR-0019).
#
# Mismas reglas que `valores-staging.env`, y conviene releerlas ahí: aquí no va ningún
# secreto, es datos y no código, y el guion del servidor lo interpreta sin ejecutarlo.
#
# **Este entorno todavía NO se puede desplegar, y es a propósito.** El dominio de
# producción sigue sin decidirse (§21.A del plan), así que `DOMINIO` y
# `ORIGENES_PERMITIDOS` no están declarados. El efecto es que un despliegue a
# producción se detiene ANTES de tocar un contenedor, con un mensaje que nombra las
# dos variables y este archivo. Inventar un dominio sería peor: produce un
# certificado inválido y una sede que no se encuentra, y el fallo aparecería con la
# sede ya publicada.
#
# Cuando el dominio se decida, se añaden las dos líneas —aquí, en un cambio revisable
# y con su propia solicitud de incorporación— y se despliega. No hace falta tocar el
# servidor.

# --- Contrato con el guion del servidor ---------------------------------------
CONTRATO_ENTORNO=1

# --- Identidad de la pila -----------------------------------------------------
REGISTRY=ghcr.io/santanderacuna
APP_NAME=sede

# --- Dominio ------------------------------------------------------------------
# PENDIENTE (§21.A): sin decidir. Al declararlo, añadir las dos líneas:
#   DOMINIO=<el dominio de la sede>
#   ORIGENES_PERMITIDOS=https://<el dominio de la sede>

# --- Base de datos ------------------------------------------------------------
DB_DATABASE=sede
DB_USERNAME=sede

# --- Almacenamiento -----------------------------------------------------------
# Producción con disco local es una decisión pendiente (T-12): mientras el depósito
# de objetos no esté, un respaldo del volumen es la única copia de los documentos.
FILESYSTEM_DISK=local
S3_BUCKET=sede
S3_ENDPOINT=
S3_REGION=us-east-1
S3_PATH_STYLE=false

# --- Correo saliente ----------------------------------------------------------
# `log` también aquí, y es una limitación declarada, no un olvido: no hay servidor de
# correo institucional conectado. Una sede que no puede avisar al ciudadano de su
# radicado tiene que decirlo en su documentación, no descubrirlo el ciudadano.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=

# --- Integraciones externas ---------------------------------------------------
IDENTIDAD_DRIVER=mock
IDENTIDAD_EMISOR=
PAGOS_DRIVER=mock
CORREO_CERTIFICADO_DRIVER=mock
CAPTCHA_DRIVER=mock
