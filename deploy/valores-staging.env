# Valores NO secretos del entorno de pruebas (ADR-0019).
#
# Este archivo viaja DENTRO de la imagen de la aplicación, en `/opt/sede-entorno/`,
# y `desplegar.sh` lo lee en el servidor para renderizar `deploy/plantilla.env`. Por
# eso la configuración es inmutable y va atada a la versión: volver a una versión
# anterior devuelve TAMBIÉN su configuración, que es lo que el mecanismo anterior
# —una publicación aparte, a mano, desde la máquina de quien despliega— no podía hacer.
#
# REGLAS, y no son de estilo:
#
#   · AQUÍ NO VA NINGÚN SECRETO. Este archivo es público y acaba dentro de una imagen
#     publicada. Los secretos viven sólo en `/etc/sede/staging.secretos.env`, en el
#     servidor, de `root` y con permisos 600. `desplegar.sh` RECHAZA este archivo si
#     declara cualquiera de los nombres de `deploy/secretos-requeridos.txt`, y una
#     guarda de la canalización lo comprueba antes de construir.
#   · Es DATOS, no código: líneas `CLAVE=valor` y nada más. El guion del servidor lo
#     interpreta con un analizador estricto y NUNCA lo ejecuta con `source`. Si lo
#     ejecutara, quien empujara una imagen al registro ejecutaría órdenes como `root`
#     en el servidor en el siguiente despliegue.
#   · El valor se toma LITERAL, de principio a fin de la línea: sin comillas que se
#     quiten, sin expansión de `$`, sin sustitución de órdenes. Un `${OTRA}` escrito
#     aquí llega tal cual al `.env`.
#   · Una línea que falte deja un marcador sin sustituir, y el despliegue se detiene
#     ANTES de tocar un contenedor diciendo qué falta y de qué archivo tiene que salir.

# --- Contrato con el guion del servidor ---------------------------------------
# `desplegar.sh` sólo acepta la versión de contrato que entiende. Si algún día este
# archivo cambia de forma (claves nuevas obligatorias, otro analizador), se sube este
# número y el despliegue se detiene con un mensaje que pide actualizar el guion del
# servidor, en lugar de renderizar a medias un entorno que nadie revisó.
CONTRATO_ENTORNO=1

# --- Identidad de la pila -----------------------------------------------------
# El guion del servidor lleva escritos su registro y su nombre de aplicación, y
# comprueba que estos dos coincidan. Es deliberado: de dónde se traen las imágenes lo
# decide el anfitrión, no un archivo que llega dentro de una imagen. Sin esa
# comprobación, una imagen manipulada podría redirigir los despliegues siguientes a
# otro registro.
REGISTRY=ghcr.io/santanderacuna
APP_NAME=sede

# --- Dominio ------------------------------------------------------------------
DOMINIO=staging.santamarta.gov.co
ORIGENES_PERMITIDOS=https://staging.santamarta.gov.co

# --- Base de datos ------------------------------------------------------------
# El nombre y el usuario no son secretos; la clave sí, y está en el archivo del
# servidor.
DB_DATABASE=sede
DB_USERNAME=sede

# --- Almacenamiento -----------------------------------------------------------
# Sin depósito de objetos todavía: disco local, declarado como apaño (T-12).
FILESYSTEM_DISK=local
S3_BUCKET=sede
S3_ENDPOINT=
S3_REGION=us-east-1
S3_PATH_STYLE=false

# --- Correo saliente ----------------------------------------------------------
# `log` escribe el correo en el registro en lugar de enviarlo. En pruebas es lo
# correcto: un entorno de pruebas que envía correo de verdad escribe a ciudadanos
# reales.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=

# --- Integraciones externas ---------------------------------------------------
# `mock` mientras no haya credenciales. La convención de la plantilla: una
# integración sin credenciales se declara APAGADA en lugar de ofrecer un botón que
# no lleva a ninguna parte.
IDENTIDAD_DRIVER=mock
IDENTIDAD_EMISOR=
PAGOS_DRIVER=mock
CORREO_CERTIFICADO_DRIVER=mock
CAPTCHA_DRIVER=mock
