-- Cuentas de la base, con separación de roles.
--
-- Se ejecuta una sola vez, al crear el volumen de datos. En un entorno ya
-- creado, los cambios se aplican con una migración, no aquí.
--
-- La regla: la aplicación NO es dueña de su esquema. Puede leer y escribir
-- filas, pero no alterar la estructura. Eso lo hace la cuenta de migraciones,
-- que sólo existe durante el despliegue.

-- Cuenta de la aplicación: filas, no estructura.
CREATE ROLE sede_app LOGIN PASSWORD :'app_password';
GRANT CONNECT ON DATABASE sede TO sede_app;
GRANT USAGE ON SCHEMA public TO sede_app;
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO sede_app;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO sede_app;

-- Que los objetos futuros hereden los mismos permisos.
ALTER DEFAULT PRIVILEGES IN SCHEMA public
    GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO sede_app;
ALTER DEFAULT PRIVILEGES IN SCHEMA public
    GRANT USAGE, SELECT ON SEQUENCES TO sede_app;

-- Cuenta de migraciones: se usa sólo durante el despliegue.
CREATE ROLE sede_migracion LOGIN PASSWORD :'migration_password';
GRANT CONNECT ON DATABASE sede TO sede_migracion;
GRANT USAGE, CREATE ON SCHEMA public TO sede_migracion;
GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA public TO sede_migracion;
GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public TO sede_migracion;
