{
  "name": "sgdi-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Panel Administrativo SGDI · Alcaldía Distrital de Santa Marta — Vue 3 + TypeScript strict",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "oxlint -D correctness && eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "test:unit": "vitest",
    "test:a11y": "vitest run --dir tests/a11y",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-brands-svg-icons": "^6.6.0",
    "@fortawesome/free-regular-svg-icons": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "@tanstack/vue-form": "^0.48.2",
    "@tanstack/vue-query": "^5.59.0",
    "@tanstack/vue-table": "^8.20.5",
    "@vueuse/core": "^11.1.0",
    "axios": "^1.7.7",
    "pinia": "^2.2.4",
    "pinia-plugin-persistedstate": "^3.2.1",
    "vue": "^3.5.10",
    "vue-i18n": "^10.0.4",
    "vue-router": "^4.4.5",
    "vue-toastification": "^2.0.0-rc.5",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-prettier": "^10.0.0",
    "@vue/eslint-config-typescript": "^14.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.10.0",
    "eslint": "^9.12.0",
    "jiti": "^2.7.0",
    "eslint-plugin-vue": "^9.28.0",
    "jsdom": "^25.0.1",
    "npm-run-all2": "^6.2.3",
    "oxlint": "^0.9.10",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.6.2",
    "vite": "^6.4.3",
    "vite-plugin-vue-devtools": "^8.1.3",
    "vitest": "^3.2.6",
    "vue-tsc": "^2.1.6"
  }
}
